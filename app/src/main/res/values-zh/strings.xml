    <!-- Onboarding -->
    <string name="onboarding_title_welcome">欢迎使用 Markleaf</string>
    <string name="onboarding_body_welcome">一款安静、以本地存储为优先的 Android Markdown 笔记应用。除非你选择分享或导出，否则文字始终保留在此设备上。</string>
    <string name="onboarding_title_markdown">使用 Markdown 写作</string>
    <string name="onboarding_body_markdown">可使用 **粗体**、_斜体_、# 标题、列表、代码和引用。随时点击顶部栏中的“预览”查看渲染效果。</string>
    <string name="onboarding_title_tags">使用 #标签 整理笔记</string>
    <string name="onboarding_body_tags">在笔记中的任意位置输入 #项目 或 #会议。应用会自动识别标签，并将其显示在“标签”界面中。</string>
    <string name="onboarding_title_local">数据保留在本地</string>
    <string name="onboarding_body_local">无需账户，不含分析功能，也不依赖云服务。你可以将任意笔记导出为 .md 文件，或将 Markleaf 指向同步文件夹（Dropbox / Google 云端硬盘 / Syncthing）以实现多设备同步。</string>
    <string name="onboarding_next">下一步</string>
    <string name="onboarding_done">开始使用</string>
    <string name="onboarding_skip">跳过</string>

