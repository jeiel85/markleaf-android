    <!-- Onboarding -->
    <string name="onboarding_title_welcome">Chào mừng đến với Markleaf</string>
    <string name="onboarding_body_welcome">Ứng dụng ghi chú Markdown yên tĩnh, ưu tiên lưu cục bộ cho Android. Văn bản của bạn luôn ở trên thiết bị này, trừ khi bạn chọn chia sẻ hoặc xuất.</string>
    <string name="onboarding_title_markdown">Viết bằng Markdown</string>
    <string name="onboarding_body_markdown">Dùng **đậm**, _nghiêng_, # tiêu đề, danh sách, mã và trích dẫn. Nhấn Xem trước trên thanh trên cùng để xem bản hiển thị bất cứ lúc nào.</string>
    <string name="onboarding_title_tags">Sắp xếp bằng #thẻ</string>
    <string name="onboarding_body_tags">Gõ #dự-án hoặc #cuộc-họp ở bất kỳ đâu trong ghi chú. Thẻ được nhận diện tự động và hiển thị trên màn hình Thẻ.</string>
    <string name="onboarding_title_local">Dữ liệu của bạn ở lại trên máy</string>
    <string name="onboarding_body_local">Không tài khoản, không phân tích, không đám mây. Xuất bất kỳ ghi chú nào thành tệp .md, hoặc chọn cho Markleaf một thư mục được đồng bộ (Dropbox / Drive / Syncthing) để dùng trên nhiều thiết bị.</string>
    <string name="onboarding_next">Tiếp</string>
