    <string name="settings_markdown">Markdown</string>
    <string name="show_markdown_syntax">Hiện cú pháp Markdown</string>
    <string name="show_markdown_syntax_description">Trình soạn thảo trực tiếp làm nổi bật các ký tự Markdown khi bạn viết.</string>
    <string name="show_formatting_button">Hiện nút định dạng</string>
    <string name="show_formatting_button_description">Giữ nút Aa trên hàng phía trên bàn phím. Khi tắt, nút này bị ẩn; hoàn tác và làm lại vẫn còn, đậm, nghiêng và liên kết vẫn xuất hiện khi bạn chọn văn bản, còn chèn nhanh bằng / không thay đổi.</string>
    <string name="line_width">Độ rộng dòng</string>
    <string name="line_width_narrow">Hẹp</string>
    <string name="line_width_comfortable">Vừa phải</string>
    <string name="line_width_wide">Rộng</string>
    <string name="line_width_description">Giữ cho dòng chữ không bị kéo dài trên màn hình rộng như máy tính bảng. Trên điện thoại cầm dọc, văn bản vốn đã vừa màn hình nên sẽ không thay đổi. Cài đặt này không đổi khoảng cách giữa các dòng.</string>
    <string name="settings_notes_section">Ghi chú &amp; tìm kiếm</string>
    <string name="show_note_previews">Hiện bản xem trước ghi chú</string>
    <string name="show_note_previews_description">Hiện một đoạn trích và thời gian sửa dưới mỗi tiêu đề. Tắt đi để hiển thị được nhiều ghi chú hơn trên màn hình.</string>
    <string name="reopen_last_note">Mở lại ghi chú gần nhất khi khởi động</string>
    <string name="reopen_last_note_description">Bắt đầu ở ghi chú bạn sửa gần nhất thay vì danh sách ghi chú.</string>
    <string name="open_notes_in_preview">Mở ghi chú ở chế độ xem trước</string>
    <string name="open_notes_in_preview_description">Hiện bản xem trước đã hiển thị định dạng khi mở ghi chú, thay vì chế độ sửa. Ghi chú mới vẫn mở để sửa. Mẹo: nhấn giữ biểu tượng xem trước/sửa trong ghi chú để bật hoặc tắt tùy chọn này.</string>
    <string name="open_notes_at">Mở ghi chú tại</string>
    <string name="open_notes_at_top">Đầu trang</string>
    <string name="open_notes_at_bottom">Cuối trang</string>
    <string name="open_notes_at_last_position">Vị trí lần trước</string>
    <string name="open_notes_at_description">Vị trí hiển thị khi bạn mở một ghi chú. Cuối trang phù hợp với ghi chú bạn chỉ viết thêm vào. “Vị trí lần trước” chỉ ghi nhớ vị trí của từng ghi chú trong ứng dụng — không có gì được ghi vào tệp của bạn.</string>
    <string name="notes_layout">Bố cục danh sách ghi chú</string>
    <string name="notes_layout_list">Danh sách</string>
    <string name="notes_layout_grid">Lưới</string>
    <string name="notes_layout_description">Lưới hiển thị ghi chú dưới dạng thẻ, với số cột vừa với màn hình. “Hiện bản xem trước ghi chú” áp dụng cho cả hai.</string>
    <string name="note_title_source">Tiêu đề ghi chú</string>
    <string name="note_title_source_first_heading">Tiêu đề mục đầu tiên</string>
    <string name="note_title_source_first_line">Dòng đầu tiên</string>
    <string name="note_title_source_description">Dòng nào trong ghi chú trở thành tiêu đề trong danh sách. “Tiêu đề mục đầu tiên” lấy tiêu đề Markdown đầu tiên ở bất kỳ đâu trong ghi chú; “Dòng đầu tiên” luôn lấy dòng đầu tiên bạn viết. Thay đổi tùy chọn này sẽ đặt lại tiêu đề cho các ghi chú hiện có — trong Trung tâm đồng bộ, “Đổi tên tệp theo tiêu đề ghi chú” sẽ cập nhật tên các tệp đã đồng bộ theo.</string>
