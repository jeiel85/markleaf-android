    <!-- Onboarding -->
    <string name="onboarding_title_welcome">Welcome to Markleaf</string>
    <string name="onboarding_body_welcome">A quiet, local-first Markdown notes app for Android. Your text stays on this device unless you choose to share or export it.</string>
    <string name="onboarding_title_markdown">Write in Markdown</string>
    <string name="onboarding_body_markdown">Use **bold**, _italic_, # headings, lists, code, and quotes. Tap Preview in the top bar to see the rendered view at any time.</string>
    <string name="onboarding_title_tags">Organize with #tags</string>
    <string name="onboarding_body_tags">Type #project or #meeting anywhere in a note. Tags are picked up automatically and shown on the Tags screen.</string>
    <string name="onboarding_title_local">Your data stays local</string>
    <string name="onboarding_body_local">No account, no analytics, no cloud. Export any note as a .md file, or point Markleaf at a synced folder (Dropbox / Drive / Syncthing) for multi-device.</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_done">Get started</string>
    <string name="onboarding_skip">Skip</string>

