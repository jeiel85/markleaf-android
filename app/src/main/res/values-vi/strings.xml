    <string name="sync_title">Đồng bộ nhiều thiết bị (phản chiếu thư mục)</string>
    <string name="sync_explainer">Bản thân Markleaf không bao giờ kết nối mạng. Thay vào đó, bạn chọn một thư mục và Markleaf lưu mỗi ghi chú thành một tệp `.md` trong đó. Nếu thư mục ấy được một ứng dụng khác đồng bộ — Dropbox, Drive, Syncthing, OneDrive, NAS — ghi chú của bạn sẽ có trên các thiết bị khác.</string>
    <string name="sync_recommended_locations">Những vị trí nên chọn cho Markleaf:\n· /Bộ nhớ trong/Dropbox/Markleaf\n· /Bộ nhớ trong/Drive/Markleaf\n· /Bộ nhớ trong/Sync/Markleaf  (Syncthing)</string>
    <string name="sync_status_unset">Chưa chọn thư mục.</string>
    <string name="sync_status_folder_format">Thư mục: %1$s</string>
    <string name="sync_status_last_synced_format">Đồng bộ lần cuối: %1$s</string>
    <string name="sync_status_last_synced_never">Đồng bộ lần cuối: chưa bao giờ</string>
    <string name="sync_metadata_mode">Siêu dữ liệu ghi chú</string>
    <string name="sync_metadata_mode_frontmatter">Trong tệp</string>
    <string name="sync_metadata_mode_sidecar">Bên cạnh các tệp</string>
    <string name="sync_metadata_mode_description">Markleaf cần biết tệp nào chứa ghi chú nào. Mặc định, ứng dụng ghi một phần đầu `---` nhỏ ở đầu mỗi tệp. “Bên cạnh các tệp” sẽ lưu thông tin đó trong một chỉ mục ẩn, để ghi chú chỉ chứa những gì bạn viết.</string>
    <string name="sync_metadata_sidecar_costs">Đánh đổi: đổi tên tệp bên ngoài Markleaf có thể làm mất liên kết với ghi chú, và thư mục được sao chép mà không kèm chỉ mục sẽ mất ngày tạo và trạng thái ghim của từng ghi chú.</string>
    <string name="sync_metadata_switched_format">Đã chuyển đổi %1$d tệp.</string>
